# Environment variables template
# Copy this file to .env.local and fill in your values

# Next.js
NEXT_PUBLIC_SITE_URL=https://sketch.com

# Email service (Gmail with App Password)
EMAIL_FROM=m88vander@gmail.com
EMAIL_TO=m88vander@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# Shopify (optional - when integrating cart)
NEXT_PUBLIC_SHOPIFY_STORE_ID=
NEXT_PUBLIC_SHOPIFY_ACCESS_TOKEN=

# Vercel (auto-configured on deployment)
VERCEL_ENV=production
